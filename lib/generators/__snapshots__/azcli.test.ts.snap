// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`generateAzCli > emits deploy.sh and snapshots first-cut output 1`] = `
"#!/usr/bin/env bash
# Generated by Bunya. Do not edit by hand.
# Document: first-cut (dev)
set -euo pipefail

echo "Checking Azure CLI login..."
az account show --only-show-errors >/dev/null || {
  echo "Run 'az login' first." >&2
  exit 1
}

# App Service app-first-cut
az webapp create --only-show-errors --resource-group "rg-first-cut" --name "app-first-cut" --plan "plan-first-cut" --runtime "NODE|20-lts" --https-only true --assign-identity '[system]' >/dev/null

# Key Vault kv-first-cut-11vqlt
az keyvault create --only-show-errors --resource-group "rg-first-cut" --name "kv-first-cut-11vqlt" --location "australiaeast" --sku "standard" --enable-rbac-authorization true --enable-purge-protection true --retention-days 7 --public-network-access Disabled >/dev/null

# Storage Account firstcutstg10rsix
az storage account create --only-show-errors --resource-group "rg-first-cut" --name "firstcutstg10rsix" --location "australiaeast" --sku "Standard_LRS" --kind "StorageV2" --min-tls-version TLS1_2 --allow-blob-public-access false --public-network-access Disabled >/dev/null

# App Service Plan plan-first-cut
az appservice plan create --only-show-errors --resource-group "rg-first-cut" --name "plan-first-cut" --location "australiaeast" --sku "B1" --is-linux >/dev/null

# Resource group rg-first-cut
az group create --name "rg-first-cut" --location "australiaeast" --only-show-errors >/dev/null
"
`;
