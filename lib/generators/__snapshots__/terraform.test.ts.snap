// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`generateTerraform > produces a stable file set for the first-cut fixture 1`] = `
{
  "mainTf": "# Generated by Bunya. Do not edit by hand.
# Document: first-cut (dev)

resource "azurerm_linux_web_app" "app_first_cut" {
  name                = "app-first-cut"
  resource_group_name = azurerm_resource_group.rg_first_cut.name
  location            = azurerm_resource_group.rg_first_cut.location
  service_plan_id     = azurerm_service_plan.plan_first_cut.id
  https_only          = true

  site_config {
    always_on = true
    minimum_tls_version = "1.2"
  }

  identity {
    type = "SystemAssigned"
  }

  app_settings = {
    AZURE_STORAGE_CONNECTION_STRING = azurerm_storage_account.first_cut_stg.primary_connection_string
    KEY_VAULT_URI = azurerm_key_vault.kv_first_cut.vault_uri
  }
}

resource "azurerm_key_vault" "kv_first_cut" {
  name                       = "kv-first-cut-11vqlt"
  resource_group_name        = azurerm_resource_group.rg_first_cut.name
  location                   = azurerm_resource_group.rg_first_cut.location
  tenant_id                  = data.azurerm_client_config.current.tenant_id
  sku_name                   = "standard"
  purge_protection_enabled   = true
  soft_delete_retention_days = 7
  enable_rbac_authorization  = true
}

resource "azurerm_role_assignment" "app_first_cut_kv_first_cut_secrets_user" {
  scope                = azurerm_key_vault.kv_first_cut.id
  role_definition_name = "Key Vault Secrets User"
  principal_id         = azurerm_linux_web_app.app_first_cut.identity[0].principal_id
}

resource "azurerm_storage_account" "first_cut_stg" {
  name                            = "firstcutstg11bwem"
  resource_group_name             = azurerm_resource_group.rg_first_cut.name
  location                        = azurerm_resource_group.rg_first_cut.location
  account_tier                    = "Standard"
  account_replication_type        = "LRS"
  account_kind                    = "StorageV2"
  min_tls_version                 = "TLS1_2"
  allow_nested_items_to_be_public = false
  public_network_access_enabled   = false
}

resource "azurerm_service_plan" "plan_first_cut" {
  name                = "plan-first-cut"
  resource_group_name = azurerm_resource_group.rg_first_cut.name
  location            = azurerm_resource_group.rg_first_cut.location
  os_type             = "Linux"
  sku_name            = "B1"
}

resource "azurerm_resource_group" "rg_first_cut" {
  name     = "rg-first-cut"
  location = "australiaeast"
}
",
  "outputsTf": "output "app_first_cut_hostname" {
  value = azurerm_linux_web_app.app_first_cut.default_hostname
}

output "first_cut_stg_id" {
  value = azurerm_storage_account.first_cut_stg.id
}
",
  "paths": [
    "versions.tf",
    "main.tf",
    "variables.tf",
    "outputs.tf",
  ],
  "versionsTf": "terraform {
  required_version = ">= 1.6.0"
  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
  }
}

provider "azurerm" {
  features {}
}

data "azurerm_client_config" "current" {}
",
}
`;
