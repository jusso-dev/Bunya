// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`generatePowerShell > snapshots first-cut script 1`] = `
"<#
.SYNOPSIS
    Deploys the first-cut architecture to Azure using the Az module.
.DESCRIPTION
    Generated by Bunya. Re-runnable. Honours -WhatIf and -Confirm.
.PARAMETER ResourceGroupName
    Resource Group to deploy into. Defaults to the value embedded in the document.
.PARAMETER Location
    Azure region. Defaults to australiaeast.
.NOTES
    Requires Az.Accounts, Az.Resources, Az.Websites, Az.Storage, Az.KeyVault,
    Az.Sql, Az.CosmosDB, Az.Network, Az.OperationalInsights, Az.ApplicationInsights,
    Az.ApiManagement, Az.ContainerRegistry, Az.ManagedServiceIdentity.
#>

[CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'Medium')]
param(
    [string]$ResourceGroupName = 'rg-first-cut',
    [string]$Location = 'australiaeast'
)

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'
$InformationPreference = 'Continue'

Write-Information "Bunya deployment for first-cut (dev)"
if (-not (Get-AzContext -ErrorAction SilentlyContinue)) {
    throw 'Run Connect-AzAccount before invoking this script.'
}

# App Service app-first-cut
$appParams = @{
    ResourceGroupName = $ResourceGroupName
    Name              = 'app-first-cut'
    Location          = $Location
    AppServicePlan    = 'plan-first-cut'
}
New-AzWebApp @appParams | Out-Null
Set-AzWebApp -ResourceGroupName $ResourceGroupName -Name 'app-first-cut' -HttpsOnly $true -AssignIdentity $true | Out-Null

# Key Vault kv-first-cut-11vqlt
$kvParams = @{
    ResourceGroupName            = $ResourceGroupName
    VaultName                    = 'kv-first-cut-11vqlt'
    Location                     = $Location
    Sku                          = 'standard'
    EnablePurgeProtection        = $true
    SoftDeleteRetentionInDays    = 7
    EnableRbacAuthorization      = $true
    PublicNetworkAccess          = 'Disabled'
}
New-AzKeyVault @kvParams | Out-Null

# Storage Account firstcutstg10rsix
$stgParams = @{
    ResourceGroupName     = $ResourceGroupName
    Name                  = 'firstcutstg10rsix'
    Location              = $Location
    SkuName               = 'Standard_LRS'
    Kind                  = 'StorageV2'
    MinimumTlsVersion     = 'TLS1_2'
    AllowBlobPublicAccess = $false
    PublicNetworkAccess   = 'Disabled'
}
New-AzStorageAccount @stgParams | Out-Null

# App Service Plan plan-first-cut
$planParams = @{
    ResourceGroupName = $ResourceGroupName
    Name              = 'plan-first-cut'
    Location          = $Location
    Tier              = 'Basic'
    NumberofWorkers   = 1
    WorkerSize        = 'B1'
    Linux             = $true
}
New-AzAppServicePlan @planParams -Force | Out-Null

# Resource Group rg-first-cut
$rgParams = @{
    Name     = 'rg-first-cut'
    Location = 'australiaeast'
    Tag      = @{ environment = 'dev'; managed_by = 'bunya' }
}
New-AzResourceGroup @rgParams -Force | Out-Null
"
`;
