exports[`generateMermaid > snapshots first-cut mermaid diagram 1`] = `
"%% Generated by Bunya. Do not edit by hand.
%% Document: first-cut (dev)
flowchart LR
    node_0["RG<br/>Main RG"]:::scaffold
    node_1["Plan<br/>Web Plan"]:::compute
    node_2["Web<br/>API Web App"]:::compute
    node_3["Stg<br/>Blob Storage"]:::data
    node_4["KV<br/>Secrets Vault"]:::security
    node_2 --> node_1
    node_2 -->|data| node_3
    node_2 ==>|identity| node_4
    classDef scaffold fill:#f6f5ee,stroke:#6b7280,color:#111;
    classDef compute fill:#dcfce7,stroke:#15803d,color:#052e16;
    classDef data fill:#fef3c7,stroke:#b45309,color:#451a03;
    classDef security fill:#fee2e2,stroke:#b91c1c,color:#450a0a;
"
`;
